// ─── Domain: Jobs ───────────────────────────────────────────────────────────────

model JobApplication {
  id               String               @id @default(uuid())
  userId           String
  portal           String
  externalJobId    String
  title            String
  company          String?
  location         String?
  url              String?
  score            Float?
  matchReasons     Json?
  status           JobApplicationStatus @default(MATCHED)
  appliedAt        DateTime?
  sessionId        String?
  errorMessage     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([userId, portal, externalJobId])
  @@index([userId, status])
}

model JobPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  portals      String[]
  roles        String[]
  locations    String[]
  skills       String[]
  minSalary    Int?
  maxDailyApps Int?     @default(10)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Domain: Shopping ───────────────────────────────────────────────────────────

model TrackedProduct {
  id                String             @id @default(uuid())
  userId            String
  site              String
  externalProductId String
  title             String
  brand             String?
  url               String?
  currency          String             @default("INR")
  lastPrice         Float?
  targetPrice       Float?
  rating            Float?
  score             Float?
  matchReasons      Json?
  priceHistory      Json?
  status            ProductTrackStatus @default(MATCHED)
  sessionId         String?
  purchasedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, site, externalProductId])
  @@index([userId, status])
}

model ShoppingPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  categories     String[]
  brands         String[]
  maxBudget      Float?
  currency       String   @default("INR")
  autoApprove    Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Domain: Travel ─────────────────────────────────────────────────────────────

model TravelBooking {
  id             String            @id @default(uuid())
  userId         String
  type           TravelBookingType
  origin         String?
  destination    String?
  departDate     DateTime?
  returnDate     DateTime?
  budget         Float?
  status         String            @default("FOUND")
  results        Json?
  selectedOption Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
}

// ─── Domain: Food ───────────────────────────────────────────────────────────────

model FoodOrder {
  id             String   @id @default(uuid())
  userId         String
  platform       String
  restaurantName String
  items          Json?
  totalAmount    Float?
  status         String   @default("ORDERED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ─── Domain: Social ─────────────────────────────────────────────────────────────

model SocialPost {
  id          String           @id @default(uuid())
  userId      String
  platform    String
  content     String
  status      SocialPostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  sessionId   String?
  likes       Int              @default(0)
  shares      Int              @default(0)
  comments    Int              @default(0)
  views       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, status])
}

// ─── Domain: Email ──────────────────────────────────────────────────────────────

model EmailAccount {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  email        String
  accessToken  String?
  refreshToken String?
  smtpHost     String?
  smtpPort     Int?
  imapHost     String?
  imapPort     Int?
  useTls       Boolean?
  isActive     Boolean   @default(true)
  isPrimary    Boolean   @default(false)
  lastSyncedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages EmailMessage[]

  @@index([userId])
}

model EmailMessage {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  messageId String?
  from      String?
  to        String[]
  cc        String[]
  bcc       String[]
  subject   String?
  bodyText  String?
  bodyHtml  String?
  labels    String[]
  category  String?
  isRead    Boolean  @default(false)
  isStarred Boolean  @default(false)
  receivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
}

model ScheduledEmail {
  id          String   @id @default(uuid())
  userId      String
  accountId   String
  to          String[]
  cc          String[] @default([])
  bcc         String[] @default([])
  subject     String
  body        String
  bodyHtml    String?
  scheduledAt DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([scheduledAt, status])
}

// ─── Domain: Calendar ───────────────────────────────────────────────────────────

model CalendarAccount {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  email        String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  calendarName String?
  timezone     String?   @default("UTC")
  isPrimary    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events CalendarEvent[]

  @@index([userId])
}

model CalendarEvent {
  id              String    @id @default(uuid())
  accountId       String
  userId          String
  externalId      String?
  title           String
  description     String?
  location        String?
  startTime       DateTime
  endTime         DateTime
  isAllDay        Boolean   @default(false)
  timezone        String?
  attendees       Json?
  travelBufferMin Int?
  source          String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId, startTime])
}

// ─── Domain: Media ──────────────────────────────────────────────────────────────

model MediaSession {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  action    String
  trackId   String?
  status    String   @default("completed")
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Domain: Voice ──────────────────────────────────────────────────────────────

model VoiceSession {
